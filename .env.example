# Copy to .env and fill in real values. Never commit .env.
XMPP_JID=agent@example.com
XMPP_PASSWORD=change-me

# Component mode instead of C2S:
# XMPP_COMPONENT_SECRET=change-me

# Authorization (comma-separated). Empty ALLOWED_DOMAINS falls back to the config
# file's default. ADMIN_JIDS lists bot administrators allowed to run developer
# commands (/debug, /tier, ...).
ALLOWED_JIDS=alice@example.com
ALLOWED_DOMAINS=example.com
ADMIN_JIDS=alice@example.com

# Silently ignore these senders (comma-separated). ignored_jids entries with '@'
# are JIDs, plain entries are domains; ignored_nicks matches MUC nicks. Ignoring
# wins over the allowlist. Leave empty to ignore nobody.
IGNORED_JIDS=
IGNORED_NICKS=

LLM_API_KEY=sk-change-me
LLM_BASE_URL=https://api.openai.com/v1

# Optional (later phases)
# TAVILY_API_KEY=
# GITHUB_TOKEN=
